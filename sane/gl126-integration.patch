+        // driver's read-only sessions (status, doctor), which hold this
+        // same lock without claiming the interface.
+        std::string gl126_lock_holder;
+        if (dev->model->asic_type == AsicType::GL126 &&
+            !gl126::process_lock_acquire(&gl126_lock_holder)) {
+            throw SaneException(SANE_STATUS_DEVICE_BUSY,
