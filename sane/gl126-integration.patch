+       = R[k+24], G[k+12], B[k]; verified offline on captured images. */
+    model.ld_shift_r = 24;
+    model.ld_shift_g = 12;
+    model.ld_shift_b = 0;
+
+    model.line_mode_color_order = ColorOrder::RGB;
+
+    model.is_cis = false;
