From f58f405ef041704068d3a5c73d2a05edcc94738a Mon Sep 17 00:00:00 2001
From: Christian Gillinger <christian.gillinger@gmail.com>
Date: Thu, 5 Nov 2026 18:54:40 +0100
Subject: [PATCH 6/6] genesys: GL126, wait for the scanner to stop after each
 calibration acquisition

Each of the seven calibration acquisitions ends with a SCAN-clear
followed by one read of reg 0x100 and one of reg 0x101. The vendor
traffic reads each register once, and the backend did the same and went
on. Bit 0 of either register is still set while the engine is running.
On a fast host the next acquisition was then armed too early and the
second dark measurement came back as a repeat of the first, which the
backend detects and refuses. Two users of the reverse-engineered
companion driver saw that failure on every scan until the driver
waited.

The two reads are now masked polls: bit 0 of reg 0x100 clear, then
bit 0 of reg 0x101 clear, 300 ms each, 4 ms apart. The one site the
vendor polls (plain 3600 dpi, after the shading measurement) keeps its
class-F match and its 5 s and now also requires bit 0 clear. A timeout
ends the scan with nothing further written and is reported as "the
previous acquisition did not stop". When the scanner has already
stopped, the transfers are those of the previous revision.

A masked poll's reply buffer now starts at a value that cannot match,
so a control read that returns no data is never taken for the awaited
state.

Only the generated tables, the runner's masked poll and one error text
change; 84 ops in gl126_tables.cpp differ, in kind, mask, want and
timeout. Verified on the scanner at 600 and 3600 dpi: at 3600 dpi three
of the fourteen polls waited 11 to 18 ms, the others settled at the
first read.

The wait was designed by bearyjd for the companion driver.
---
 backend/genesys/gl126.cpp        |  25 ++++-
 backend/genesys/gl126_ops.cpp    |   6 +-
 backend/genesys/gl126_ops.h      |   8 +-
 backend/genesys/gl126_tables.cpp | 168 +++++++++++++++----------------
 4 files changed, 119 insertions(+), 88 deletions(-)

diff --git a/backend/genesys/gl126.cpp b/backend/genesys/gl126.cpp
index 48e816afd..539f650d0 100644
--- a/backend/genesys/gl126.cpp
+++ b/backend/genesys/gl126.cpp
@@ -223,6 +223,26 @@ const OpProgram& find_program(const Profile& profile, const char* name)
                         profile.name, name);
 }
 
+/** True if op `idx` of `prog` is one of the calibration stop gate's two
+    polls: a PollMasked read of reg 0x100 or
+    0x101 that waits for bit 0 clear, generated after the SCAN-clear that
+    ends each calibration acquisition. Decided from the op itself, not
+    from the phase name, and by the gate's two exact mask/want pairs:
+    PARK's completion wait reads reg 0x101 too (mask 0xe3) and is not a
+    gate op. */
+bool is_scanstop_gate_op(const OpProgram& prog, std::size_t idx)
+{
+    if (idx >= prog.count) {
+        return false;
+    }
+    const Op& op = prog.ops[idx];
+    const bool bit0_clear = op.mask == 0x01 && op.want == 0x00;
+    const bool class_f_and_bit0_clear = op.mask == 0xf1 && op.want == 0xf0;
+    return op.kind == OpKind::PollMasked && op.value == 0x018e &&
+           (op.index == 0x0022 || op.index == 0x0122) &&
+           (bit0_clear || class_f_and_bit0_clear);
+}
+
 /** Run one captured phase as its op program: the captured transfers in
     the captured order, the one real wait (data-ready) as an explicit
     poll with a timeout, and every failure ending the hook with zero
@@ -245,7 +265,10 @@ void run_phase_program(Genesys_Device* dev, const Profile& profile, const char*
             case OpsFailure::BadAck: what = "register write not acknowledged"; break;
             case OpsFailure::PollTimeout:
                 status = SANE_STATUS_DEVICE_BUSY;
-                what = "data-ready never set";
+                what = is_scanstop_gate_op(prog, e.op_index)
+                    ? "the previous acquisition did not stop (bit 0 of reg 0x100/0x101 "
+                      "still set)"
+                    : "data-ready never set";
                 break;
             case OpsFailure::ShortBulk: what = "short bulk read"; break;
             case OpsFailure::MissingInjection:
diff --git a/backend/genesys/gl126_ops.cpp b/backend/genesys/gl126_ops.cpp
index 8d2e3b9de..977a8a964 100644
--- a/backend/genesys/gl126_ops.cpp
+++ b/backend/genesys/gl126_ops.cpp
@@ -383,7 +383,11 @@ void do_poll_masked(Wire& wire, const Op& op, std::size_t idx, RunResult& out,
     unsigned polls = 0;
 
     for (;;) {
-        std::uint8_t reply[2] = {0, 0};
+        // The buffer starts as a value that cannot match, so a transfer
+        // that returns no data is never taken for the awaited state. With
+        // zeros a wait for a CLEAR bit (the calibration stop gate, want
+        // 0x00) would have passed on an empty reply.
+        std::uint8_t reply[2] = {static_cast<std::uint8_t>(~op.want), 0};
         wire.control_read(op.request, op.value, op.index, reply, 2);
         ++polls;
         if (polls == 1) {
diff --git a/backend/genesys/gl126_ops.h b/backend/genesys/gl126_ops.h
index 0cdddcb08..ee320ce4c 100644
--- a/backend/genesys/gl126_ops.h
+++ b/backend/genesys/gl126_ops.h
@@ -223,10 +223,14 @@ struct RunPolicy {
                        recorded, never fails on a mismatch.
       PollMasked    -> loop: control_read(op's own request/value/index,
                        ..., 2); (reply[0] & op.mask) == op.want -> done,
-                       recorded (a PollRecord); else timeout
+                       recorded (a PollRecord); a read that returns no
+                       data never matches (the buffer starts at a value
+                       that cannot); else timeout
                        (policy.masked_timeout_ms) -> OpsError{PollTimeout}
                        (message carries first/last), nothing further
-                       sent; else sleep_ms(...). Its two real uses:
+                       sent; else sleep_ms(...). Its real uses: the
+                       calibration stop gate (bit 0 of reg 0x100 and of
+                       reg 0x101 clear after each acquisition),
                        POSITION's W3 (class F on reg 0x101) and PARK's
                        Wait A (reg 0x35 bit 0x40)/Wait B (the
                        PARK_COMPLETE status word).
