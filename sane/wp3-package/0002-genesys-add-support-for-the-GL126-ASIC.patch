+const OpProgram* magazine_program(const char* name)
+{
+    if (name == nullptr) {
+        return nullptr;
+    }
+    for (std::size_t i = 0; i < MAGAZINE_PROGRAM_COUNT; ++i) {
+        if (std::strcmp(MAGAZINE_PROGRAMS[i].name, name) == 0) {
+            return &MAGAZINE_PROGRAMS[i];
+        }
+    }
+    return nullptr;
+}
