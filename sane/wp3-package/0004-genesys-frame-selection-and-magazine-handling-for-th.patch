+  s->opt[OPT_LOAD_FILM].name = "load-film";
+  s->opt[OPT_LOAD_FILM].title = SANE_I18N ("Load film");
+  s->opt[OPT_LOAD_FILM].desc =
+    SANE_I18N ("Press this, then take the magazine fully out and push it back in to the "
