+  s->opt[OPT_FRAME].type = SANE_TYPE_INT;
+  s->opt[OPT_FRAME].unit = SANE_UNIT_NONE;
+  s->opt[OPT_FRAME].constraint_type = SANE_CONSTRAINT_RANGE;
