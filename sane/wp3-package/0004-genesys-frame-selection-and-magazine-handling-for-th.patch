+  s->opt[OPT_FRAME].name = "frame";
+  s->opt[OPT_FRAME].title = SANE_I18N ("Frame");
+  s->opt[OPT_FRAME].desc = SANE_I18N ("Frame of the film strip to scan (1-6, counted from the "
