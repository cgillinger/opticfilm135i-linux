   s->opt[OPT_MODE].size = max_string_size (mode_list);
   s->opt[OPT_MODE].constraint.string_list = mode_list;
   s->mode = SANE_VALUE_SCAN_MODE_GRAY;
+  if (model->asic_type == AsicType::GL126) {
